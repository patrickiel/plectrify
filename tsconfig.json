{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    // These are .ts files run directly by tsx, so imports name the .ts source
    // rather than a built .js that never exists.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  // A glob rather than a hand-listed set, which had already drifted: it omitted
  // release.ts, so `pnpm check` never type-checked the release dispatcher.
  "include": ["scripts/**/*.ts"]
}
