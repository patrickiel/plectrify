<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements applied when scripts/release.macos.ts signs the app with the hardened
  runtime (required for notarization). Exactly two, deliberately:

  - audio-input: the app processes a live guitar signal; without this (and the
    NSMicrophoneUsageDescription that juce_add_gui_app writes into the plist)
    macOS silently delivers silence.
  - disable-library-validation: the app loads third-party VST3 code in-process,
    signed by other teams or not at all. Library validation would refuse every
    one of them. The catalogue's signed manifest and SHA-256 pins remain the
    trust root for what gets loaded, exactly as on Windows.

  Xcode-generator builds get the same set via HARDENED_RUNTIME_OPTIONS in
  CMakeLists.txt; this file is the explicit-codesign (Ninja) counterpart. Keep
  the two in sync.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
