Give a hosted plugin room to write the whole of a VstPinProperties.

Steinberg's original header declares VstPinProperties with 48 reserved bytes
at the end, 128 in all, and a plugin built against it fills all 128 when
answering effGetInputProperties / effGetOutputProperties (DPF memsets the
whole struct). Plectrify compiles JUCE's hosting code against FST, a
clean-room header (see CMakeLists.txt) that declares only the 80 bytes whose
meaning is known, so each `Vst2::VstPinProperties pinProps;` JUCE puts on
the stack was overrun by 48 bytes into its neighbours. The six sites now
read the fields through a struct that pads the storage to more than either
layout; the field offsets JUCE reads are the same under both headers.
diff --git a/modules/juce_audio_processors_headless/format_types/juce_VSTPluginFormatImpl.h b/modules/juce_audio_processors_headless/format_types/juce_VSTPluginFormatImpl.h
index 49646f36a..cb51043f6 100644
--- a/modules/juce_audio_processors_headless/format_types/juce_VSTPluginFormatImpl.h
+++ b/modules/juce_audio_processors_headless/format_types/juce_VSTPluginFormatImpl.h
@@ -93,6 +93,22 @@ JUCE_BEGIN_IGNORE_DEPRECATION_WARNINGS
 namespace juce
 {
 
+//==============================================================================
+/** PLECTRIFY_VST2_PIN_PROPERTIES_PADDING: storage for a VstPinProperties that a
+    plugin may write more into than this header's sizeof. The original SDK
+    declares the struct with 48 bytes of reserved space at the end (128 in
+    all); a plugin built against it fills all 128 — DPF memsets the whole
+    struct before answering effGetInputProperties — while a clean-room header
+    (FST) declares only the known 80. On the stack that was a 48-byte overrun
+    into whatever lived beside it. The fields are read through `props`, which
+    sits at the start of a buffer large enough for either layout.
+*/
+struct PaddedVstPinProperties
+{
+    Vst2::VstPinProperties props {};
+    char padding[256] {};
+};
+
 //==============================================================================
 namespace
 {
@@ -1483,7 +1499,7 @@ struct VSTPluginInstanceHeadless : public AudioPluginInstance,
     {
         if (isValidChannel (index, true))
         {
-            Vst2::VstPinProperties pinProps;
+            PaddedVstPinProperties pinPropsStorage; auto& pinProps = pinPropsStorage.props;
             if (dispatch (Vst2::effGetInputProperties, index, 0, &pinProps, 0.0f) != 0)
                 return String (pinProps.label, sizeof (pinProps.label));
         }
