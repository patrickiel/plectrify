{
  "name": "plectrify-packaging",
  "private": true,
  "type": "module",
  "description": "Tooling for publishing the plugin catalogue to Cloudflare R2. Separate from ui/ because it is release infrastructure, not an application dependency — nothing here is bundled into the app. TypeScript via tsx rather than PowerShell so it runs on macOS and Linux too.",
  "scripts": {
    "setup-r2": "tsx scripts/setup-r2.ts",
    "keygen": "tsx scripts/keygen.ts",
    "publish-catalogue": "tsx scripts/publish.ts",
    "validate": "tsx scripts/validate.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test scripts/*.test.ts",
    "verify-live": "tsx scripts/verify-live.ts",
    "host-plugin": "tsx scripts/host-plugin.ts",
    "host-content": "tsx scripts/host-content.ts",
    "host": "tsx scripts/host.ts",
    "build-plugin": "tsx scripts/build-plugin.ts",
    "check-updates": "tsx scripts/check-updates.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "fflate": "^0.8.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "wrangler": "4.120.0"
  }
}
